# ==========================================
# TEAMSKI - ENVIRONMENT
# ==========================================
#
# Copy to .env.local and fill in. Never commit
# .env.local - it is in .gitignore.
#
# Only the first block is required. Everything
# else switches a feature on; leave it out and that
# feature is hidden or falls back quietly.
#


# ------------------------------------------
# REQUIRED
# ------------------------------------------

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Bypasses row level security. Server and worker
# only - never give it a NEXT_PUBLIC_ name.
SUPABASE_SERVICE_ROLE_KEY=

# Encrypts API keys, OAuth tokens, MCP sign-ins and
# AI memory before they are stored. Generate with:
#   openssl rand -base64 32
# Back it up off the server. Lose it and everything
# it sealed is unreadable; never change it once set.
TEAMSKI_SECRET_KEY=

# The public address, used for sign-in and connect
# callbacks and links in emails.
NEXT_PUBLIC_SITE_URL=http://localhost:3000


# ------------------------------------------
# BUILT-IN AI (at least one)
# ------------------------------------------

# Shared keys that serve every user, rationed by
# each plan's daily message allowance.
GROQ_API_KEY=
CEREBRAS_API_KEY=

# A local model through Ollama. Also used for
# memory embeddings (nomic-embed-text).
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:1.7b
OLLAMA_UTILITY_MODEL=qwen3:1.7b
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_NUM_CTX=8192

# Would give every user these models on your bill.
# Usually left empty: people add their own keys in
# Settings instead.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=


# ------------------------------------------
# OPTIONAL FEATURES
# ------------------------------------------

# Image generation (Cloudflare Workers AI).
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Web search. Without it, search uses DuckDuckGo.
BRAVE_API_KEY=

# Connections. Separate from sign-in with Google
# or GitHub, which is configured in Supabase.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_SIGNIN_CLIENT_ID=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Email (invites, reminders, alerts) through Resend.
RESEND_API_KEY=
EMAIL_FROM=Teamski <invites@your-domain.com>

# Who can open /admin, and who gets error alerts.
ADMIN_EMAILS=
ALERT_EMAILS=

# Payments (Razorpay). Without them the Team plan
# cannot be bought; set plans by hand instead.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Contact-sales form: a Google Apps Script web app
# (scripts/enterprise-sheet.gs) and/or an inbox.
ENTERPRISE_SHEET_URL=
ENTERPRISE_SHEET_SECRET=
ENTERPRISE_NOTIFY_EMAILS=

# Meta (Facebook / Instagram) ads. Empty = off.
NEXT_PUBLIC_META_PIXEL_ID=
META_PIXEL_ID=
META_CAPI_TOKEN=
META_TEST_EVENT_CODE=
META_GRAPH_VERSION=v24.0

# How many background agent runs the worker
# advances at once.
WORKER_CONCURRENCY=8
